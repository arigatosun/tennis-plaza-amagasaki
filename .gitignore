# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/
.idea/

# test / mcp artifacts
.playwright-mcp/
tmp_pdf_pages/
tpa-*.png
hero-*.png

# AI generation raw sources (heavy PNG originals; keep optimized JPEGs in repo)
public/images/recruit/ai/

# Client meeting recordings (audio originals stored elsewhere)
client_gijiroku/*.m4a
client_gijiroku.zip
# Whisper intermediate/log files (raw md kept, intermediates excluded)
client_gijiroku/transcripts/_*.log
client_gijiroku/transcripts/*_first_pass.txt
client_gijiroku/transcripts/*_chunk*.txt

# 録音元データ（大容量・文字起こし済みのため非追跡）
syanai_gijiroku/*.m4a
client_gijiroku/*.m4a
